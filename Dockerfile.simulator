# Sentience MQTT Device Simulator — Dockerfile
#
# Publishes simulated IoT device telemetry, status, and events to a
# shared MQTT broker so the realtime bridge can consume them.
#
# Runs the simulate CLI from @sentience/mock via tsx.

FROM node:20-alpine AS base
RUN npm install -g pnpm@10.14.0
WORKDIR /app

# ─── Dependencies ──────────────────────────────────────────────────
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/mock/package.json packages/mock/
COPY packages/types/package.json packages/types/

RUN pnpm install --frozen-lockfile

# ─── Shared packages source ────────────────────────────────────────
COPY packages/types/src packages/types/src

# ─── Mock / Simulator source ───────────────────────────────────────
COPY packages/mock/src packages/mock/src

# ─── Environment defaults ──────────────────────────────────────────
ENV MQTT_URL=mqtt://mosquitto:1883
ENV MQTT_TOPIC_PREFIX=sentience
ENV SIMULATOR_DEVICE_COUNT=25

EXPOSE 3000

# Use shell form so $VAR expansion works
CMD pnpm --filter @sentience/mock simulate -- --count ${SIMULATOR_DEVICE_COUNT:-25} --broker ${MQTT_URL:-mqtt://mosquitto:1883} --topic-prefix ${MQTT_TOPIC_PREFIX:-sentience}
