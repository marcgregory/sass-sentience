# Dockerfile.simulator
#
# MQTT Device Simulator — standalone service for Render/Railway/Fly.io
#
# Publishes simulated IoT device telemetry, status, and events to a
# shared MQTT broker so the realtime bridge can consume them.
#
# Usage:
#   docker build -f Dockerfile.simulator -t sentience-simulator .
#   docker run -e MQTT_URL=mqtt://broker.hivemq.com:1883 sentience-simulator
#
# Environment variables:
#   MQTT_URL              — MQTT broker URL (default: mqtt://broker.hivemq.com:1883)
#   MQTT_TOPIC_PREFIX     — Topic prefix  (default: sentience)
#   SIMULATOR_DEVICE_COUNT— Number of simulated devices (default: 55)

FROM node:20-alpine AS base
RUN npm install -g pnpm@10.14.0
WORKDIR /app

# ─── Install dependencies ──────────────────────────────────────────
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/types/package.json packages/types/
COPY packages/mock/package.json packages/mock/
RUN pnpm install --frozen-lockfile

# ─── Copy source code ──────────────────────────────────────────────
COPY packages/types/src  packages/types/src
COPY packages/mock/src   packages/mock/src

# ─── Runtime ────────────────────────────────────────────────────────
ENV MQTT_URL=mqtt://broker.hivemq.com:1883
ENV MQTT_TOPIC_PREFIX=sentience
ENV SIMULATOR_DEVICE_COUNT=55
ENV PORT=3000

# Tiny HTTP health-check server so Render (free Web Service tier) sees
# an open port and doesn't kill the container. The simulator runs in
# the background alongside this lightweight listener.
CMD node -e "
  const http = require('http');
  const { spawn } = require('child_process');

  // HTTP health-check server — Render needs at least one open port
  http.createServer((req, res) => {
    res.writeHead(200, { 'Content-Type': 'text/plain' });
    res.end('OK');
  }).listen(process.env.PORT || 3000, () => {
    console.log('[health] HTTP server on port ' + (process.env.PORT || 3000));
  });

  // Spawn simulator in the foreground so container stays alive
  const sim = spawn('pnpm', [
    '--filter', '@sentience/mock', 'simulate',
    '--', '--count', process.env.SIMULATOR_DEVICE_COUNT || '55'
  ], { stdio: 'inherit' });

  sim.on('exit', (code) => {
    console.log('[simulator] exited with code ' + code);
    process.exit(code);
  });
"
