# Database
# Local: postgres://sentience:sentience@localhost:5433/sentience
# Production: Use environment variable (NEVER hardcode credentials)
DATABASE_URL=postgres://user:password@host:5432/database

# JWT — REQUIRED: generate a secure random string (min 32 chars)
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-in-production

# CORS — set to your frontend URL in production
# CORS_ORIGIN=https://app.sentience.io

# Rate limiting (requests per minute, per IP)
# RATE_LIMIT_MAX=100

# Server
PORT=3001
# In production, bind to 127.0.0.1 behind a reverse proxy
HOST=0.0.0.0

# Socket.IO
# Allow unauthenticated WebSocket connections (DEV ONLY — never in production)
# SOCKET_ALLOW_UNAUTHENTICATED=true

# Realtime WebSocket URL for backend service-to-service connection
# Local dev: http://localhost:3002
# Production: wss://sass-sentience-realtime.onrender.com
REALTIME_WS_URL=http://localhost:3002
