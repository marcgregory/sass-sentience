# Sentience Realtime Bridge — Environment Variables
#
# Copy this file to .env and fill in your values.
#
# Local development (Docker Mosquitto + local Next.js):
#   MQTT_URL=mqtt://localhost:1883
#   SOCKET_PORT=3001
#   CORS_ORIGIN=http://localhost:3000
#
# Production (cloud MQTT + deployed web app):
#   MQTT_URL=mqtt://broker.hivemq.com:1883
#   SOCKET_PORT=3002
#   CORS_ORIGIN=https://your-app.vercel.app
#   JWT_SECRET=your-jwt-secret-here

# MQTT broker URL (default: mqtt://localhost:1883)
MQTT_URL=mqtt://localhost:1883

# MQTT topic prefix (default: sentience)
MQTT_TOPIC_PREFIX=sentience

# Port for the Socket.IO server (default: 3001)
SOCKET_PORT=3001

# CORS origin for Socket.IO (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# JWT secret for authenticating WebSocket connections (must match API server)
JWT_SECRET=your-jwt-secret-here

# Allow unauthenticated Socket.IO connections (DEV ONLY — set to true for local dev)
SOCKET_ALLOW_UNAUTHENTICATED=true

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
