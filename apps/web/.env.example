# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Socket.IO server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# Demo login (quick role cards on login page)
# Requires BOTH NODE_ENV !== "production" AND this flag set to "true".
# Safely defaults to disabled in production regardless of this value.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
