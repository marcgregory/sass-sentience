{
  "name": "sentience",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:start": "docker compose -f apps/api/docker-compose.yml up -d",
    "db:stop": "docker compose -f apps/api/docker-compose.yml down",
    "db:migrate": "pnpm --filter @sentience/api db:migrate",
    "db:seed": "pnpm --filter @sentience/api db:seed",
    "api:dev": "pnpm --filter @sentience/api dev",
    "api:start": "pnpm --filter @sentience/api start"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": ["bcrypt"]
  }
}
