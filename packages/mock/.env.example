# MQTT Device Simulator — Environment Variables
#
# Copy this file to .env and fill in your MQTT broker details.
#
# For local development (Docker Mosquitto on default ports):
#   MQTT_URL=mqtt://localhost:1883
#
# For testing with a deployed realtime bridge (same broker it reads from):
#   MQTT_URL=mqtt://broker.hivemq.com:1883

# MQTT broker URL (default: mqtt://localhost:1883)
MQTT_URL=mqtt://localhost:1883

# MQTT topic prefix (default: sentience)
# Must match the prefix the realtime bridge is configured to subscribe to.
MQTT_TOPIC_PREFIX=sentience
